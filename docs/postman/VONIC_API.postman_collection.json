            ],
            "body": { "mode": "raw", "raw": "{\n    \"email\": \"admin@ugm.ac.id\",\n    \"otp\": \"123456\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/verify-otp", "host": ["{{baseUrl}}"], "path": ["verify-otp"] }
          }
        },
        {
          "name": "3. Login User Google (SSO)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json", "type": "text" },
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": { "mode": "raw", "raw": "{\n    \"id_token\": \"eyJhbGciOiJ...\"\n}", "options": { "raw": { "language": "json" } } },
            "url": { "raw": "{{baseUrl}}/login-user", "host": ["{{baseUrl}}"], "path": ["login-user"] }
          }
        },
        {
          "name": "4. Logout",
          "request": {
