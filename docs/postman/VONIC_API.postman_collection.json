{
  "info": {
    "_postman_id": "b80b31ca-efd1-426c-aac5-7ec6573b0075",
    "name": "SI Pemilihan Wisata (VONIC)",
    "description": "Postman Collection resmi untuk SI Pemilihan Wisata (VONIC).\n\nMendukung alur autentikasi admin via OTP email, login user via Google SSO (UGM), polling publik & voting partisipan (dukungan multi-size / keranjang kaos & single fallback), status voting otomatis (sudah_memilih), opsi kelompok dinamis (string bebas), galeri multi-foto (hingga 3 foto per item dengan accessor foto_url), serta manajemen admin lengkap.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000/api",
      "type": "string"
    },
    {
      "key": "token_admin",
      "value": "",
      "type": "string"
    },
    {
      "key": "token_user",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. Authentication",
      "item": [
        {
          "name": "1. Request OTP (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@ugm.ac.id\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/request-otp",
              "host": ["{{baseUrl}}"],
              "path": ["request-otp"]
            },
            "description": "Mengirimkan 6 digit OTP ke email admin yang terdaftar (berlaku 5 menit)."
          },
          "response": []
        },
        {
          "name": "2. Verify OTP (Admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"admin@ugm.ac.id\",\n    \"otp\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/verify-otp",
              "host": ["{{baseUrl}}"],
              "path": ["verify-otp"]
            },
            "description": "Memverifikasi OTP admin dan mengembalikan Bearer Token untuk admin (simpan ke variable token_admin)."
          },
          "response": []
        },
        {
          "name": "3. Login User (Google SSO)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"id_token\": \"eyJhbGciOiJSUzI1NiIsImtpZCI6Ij...\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/login-user",
              "host": ["{{baseUrl}}"],
              "path": ["login-user"]
            },
            "description": "Login peserta menggunakan Google ID Token UGM (@ugm.ac.id) terverifikasi. Mengembalikan token peserta (simpan ke variable token_user)."
          },
          "response": []
        },
        {
          "name": "4. Get User Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_user}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/profile",
              "host": ["{{baseUrl}}"],
              "path": ["profile"]
            },
            "description": "Mengambil data profil pengguna yang sedang login."
          },
          "response": []
        },
        {
          "name": "5. Logout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_user}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/logout",
              "host": ["{{baseUrl}}"],
              "path": ["logout"]
            },
            "description": "Menghapus token sesi aktif."
          },
          "response": []
        }
      ]
    },
    {
      "name": "02. Polling (Publik & Detail)",
      "item": [
        {
          "name": "1. Get All Polling",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/polling",
              "host": ["{{baseUrl}}"],
              "path": ["polling"]
            },
            "description": "Menampilkan daftar seluruh periode polling beserta relasi galeri foto paket wisata dan desain kaos."
          },
          "response": []
        },
        {
          "name": "2. Get Detail Polling",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_user}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/polling/1",
              "host": ["{{baseUrl}}"],
              "path": ["polling", "1"]
            },
            "description": "Menampilkan detail satu periode polling. Jika header Authorization Bearer disertakan, respons langsung menyertakan status 'sudah_memilih': true/false."
          },
          "response": []
        },
        {
          "name": "3. Get Pilihan Polling (Termasuk Status sudah_memilih)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_user}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/polling/1/pilihan",
              "host": ["{{baseUrl}}"],
              "path": ["polling", "1", "pilihan"]
            },
            "description": "Mengambil opsi pilihan pada periode polling (paket wisata, kaos, ukuran kaos). Jika user menyertakan token auth, langsung mengembalikan properti 'sudah_memilih': true/false dan data rincian 'partisipasi_user' jika sudah memilih."
          },
          "response": []
        },
        {
          "name": "4. Get Hasil Polling (Publik)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/polling/1/hasil",
              "host": ["{{baseUrl}}"],
              "path": ["polling", "1", "hasil"]
            },
            "description": "Menampilkan statistik hasil voting periode polling. Otomatis menyesuaikan mode rombongan (digabung atau dipisah per kategori dosen/tendik)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "03. Voting & Riwayat (User)",
      "item": [
        {
          "name": "1. Submit Vote (Multi-Size / Keranjang Kaos)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_user}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"id_paket\": 1,\n    \"id_kaos\": 1,\n    \"items_kaos\": [\n        {\n            \"id_ukuran\": 1,\n            \"jumlah\": 1\n        },\n        {\n            \"id_ukuran\": 2,\n            \"jumlah\": 2\n        }\n    ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/polling/1/vote",
              "host": ["{{baseUrl}}"],
              "path": ["polling", "1", "vote"]
            },
            "description": "Kebutuhan riil FE: Mengirim vote dengan multi-ukuran kaos (keranjang). Mendukung array 'items_kaos' maupun 'ukuran'."
          },
          "response": []
        },
        {
          "name": "2. Submit Vote (Single Size - Fallback)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_user}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"id_paket\": 1,\n    \"id_kaos\": 1,\n    \"id_ukuran\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/polling/1/vote",
              "host": ["{{baseUrl}}"],
              "path": ["polling", "1", "vote"]
            },
            "description": "Fallback kompatibilitas: Pemilih yang hanya mengirim 1 'id_ukuran' tunggal tetap diterima (otomatis dicatat dengan jumlah = 1)."
          },
          "response": []
        },
        {
          "name": "3. Riwayat Voting Peserta",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_user}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/riwayat-voting",
              "host": ["{{baseUrl}}"],
              "path": ["riwayat-voting"]
            },
            "description": "Menampilkan riwayat partisipasi voting user yang sedang login beserta paket, kaos, dan rincian ukuran."
          },
          "response": []
        }
      ]
    },
    {
      "name": "04. Admin - Dashboard",
