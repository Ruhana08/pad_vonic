                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/admin/paket-wisata",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "paket-wisata"]
            },
            "description": "Menambahkan paket wisata baru dengan dukungan foto utama dan multi-foto galeri (hingga 3 foto total)."
