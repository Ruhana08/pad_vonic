    {
      "name": "06. Admin - Manajemen Paket Wisata",
      "item": [
        {
          "name": "1. Tambah Paket Wisata (Multi-Foto / Galeri)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_admin}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "nama_destinasi",
                  "value": "Pantai Parangtritis & Gumuk Pasir",
                  "type": "text"
                },
                {
                  "key": "lokasi",
                  "value": "Bantul, D.I. Yogyakarta",
                  "type": "text"
                },
                {
                  "key": "jarak",
                  "value": "30 km",
                  "type": "text"
                },
                {
                  "key": "durasi_perjalanan",
                  "value": "1 Jam 15 Menit",
                  "type": "text"
                },
                {
                  "key": "benefit",
